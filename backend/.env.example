# 앱 기본 (Phase 2부터 사용)
APP_ENV=development
APP_NAME=shiftmate
LOG_LEVEL=INFO

# DB (Phase 3부터 실제 사용)
DATABASE_URL=postgresql+psycopg://shiftmate:shiftmate@db:5432/shiftmate
POSTGRES_DB=shiftmate
POSTGRES_USER=shiftmate
POSTGRES_PASSWORD=change-me

# 업로드 (Phase 4부터 실제 사용)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# 파서 (Phase 4부터 실제 사용)
PARSER_BACKEND=mock
